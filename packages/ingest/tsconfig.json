{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    // A fresh service: resolve @pumpking/core through its package "exports", no path aliases
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true
  },
  "include": ["./src/**/*.ts", "./scripts/**/*.ts"]
}
