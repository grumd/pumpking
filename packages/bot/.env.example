NODE_ENV='development'
APP_PORT=3003
# The Telegram bot starts only with a token. It allows a single long-polling bot, so set it
# only once the legacy Python bot (piu-top rivals-bot) using the same token is stopped
TELEGRAM_BOT_TOKEN=
# The admin's chat id and Telegram username: errors go to the admin, and the admin can use
# `rivals test`
TELEGRAM_ADMIN_ID=
TELEGRAM_ADMIN_NICKNAME=
# Channel for the tournament start / end posts (optional)
TOURNAMENTS_CHANNEL_ID=
# The location (agent name) whose watchers (space-separated chat ids) hear when it starts,
# stalls, resumes, or a new player shows up (optional)
TRACKED_LOCATION_NAME=
TRACKED_LOCATION_REPORT_TO_USERS=
# A TP-Link Kasa plug whose on / off the admin hears about (optional, all three needed)
TRACKED_KASA_LOGIN=
TRACKED_KASA_PASSWORD=
TRACKED_KASA_DEVICE=
# The admin hears when one of these /healthz stops answering (optional). Prod:
# http://127.0.0.1:3002/healthz and https://api.pumpking.top:3001/healthz
INGEST_HEALTH_URL=
API_HEALTH_URL=
