{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "target": "ES2022",
    "module": "CommonJS",
    "rootDir": ".",
    "composite": true,
    "incremental": true,
    "emitDeclarationOnly": true,
    "declarationDir": "./types"
  },
  // Relative imports only: tsx runs this package with the importing service's tsconfig.
  // Migrations aren't type-checked (they never were, and they only run once)
  "include": ["./src/**/*.ts", "./scripts/**/*.ts"]
}
