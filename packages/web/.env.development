# Empty = same-origin; the Vite dev server proxies /trpc and /results to
# localhost:3001 (see vite.config.ts). This is what makes remote dev access
# (tailscale IP / tunnels) work - a hardcoded localhost URL would resolve on
# the visiting machine instead.
VITE_API_BASE_PATH=
VITE_SOCKET_MODE= # empty is false
VITE_SOCKET_IP_BASE=
VITE_DEBUG_RESULTS=false
VITE_DISCORD_CLIENT_ID=1460267206494388367