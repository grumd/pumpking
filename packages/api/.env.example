NODE_ENV='development'
APP_PORT=3001
DB_DATABASE=
DB_DATABASE_TEST=test
DB_USERNAME=
DB_PASSWORD=
HTTPS_PUBLIC_CERT_PATH=
HTTPS_PRIVATE_KEY_PATH=
SCREENSHOT_BASE_FOLDER=~/screenshots
SCREENSHOT_AGENT_BASE_FOLDER=~/screenshots
# allowed patterns: {playerId}, {token}, {nickname}, {email}
# {dateAdded}, {dateTimeAdded} (of upload to server),
# {date}, {dateTime} (of screenshot from EXIF)
SCREENSHOT_FILE_PATH_DB={nickname}/{dateAdded}/{dateTimeAdded}.jpg
OPENAI_API_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# "enabled" schedules the monthly tournament jobs (create on the 1st, end on the 25th)
TOURNAMENT_JOB=
# The legacy Python API (piu-top), which the admin purgatory recheck calls until ingestion
# is ported. Prod: http://127.0.0.1:5001 (gunicorn); locally `python main.py dev` serves :5000
LEGACY_API_URL=
